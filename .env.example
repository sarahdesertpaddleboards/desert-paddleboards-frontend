# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Google Maps JavaScript API key (publishable / browser key).
# This appears in the client bundle by design — protect it in Google Cloud
# Console with HTTP referrer restrictions, NOT by keeping it secret.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: override the backend API base URL (defaults handle localhost vs prod)
# VITE_API_BASE_URL=
